# Base de datos: PostgreSQL (producción) o SQLite (local). Sin ninguna, usa memoria.
DATABASE_URL=postgres://usuario:clave@localhost:5432/sinhumo
# SQLITE_PATH=./sinhumo.db

# Clave para cifrar contraseñas IMAP, secretos de webhooks, etc. (obligatoria)
VAULT_MASTER_KEY=cambiar-por-una-clave-larga-y-aleatoria
PUBLIC_BASE_URL=https://sinhumo.example
PORT=8080

# IA (opcional: sin clave usa el motor de reglas)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Instrucciones escondidas: además de las reglas, un clasificador con IA (una llamada más por texto analizado)
PROMPT_GUARD_LLM=0

# WhatsApp Business Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Número público (con código de país) para el botón "vincular WhatsApp" de la web
WHATSAPP_PUBLIC_NUMBER=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_SECRET_TOKEN=
# Usuario del bot (sin @) para el botón "vincular Telegram" de la web
TELEGRAM_BOT_USERNAME=

# Mail saliente (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Sin Humo <analizar@sinhumo.example>

# Mail entrante (SMTP): registro MX del dominio apuntando a este servidor
SMTP_INBOUND_PORT=
SMTP_ACCEPTED_DOMAINS=sinhumo.example
# Servidores cuyo Authentication-Results es confiable (tu MTA de recepción)
MAIL_TRUSTED_AUTHSERV_IDS=mx.sinhumo.example

# Pagos
PAYMENTS_WEBHOOK_SECRET=

# MCP por stdio
SINHUMO_API_KEY=

LOAD_DEMO_DATA=0

# Login con Google (opcional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Métricas (Prometheus): token para GET /metrics
METRICS_TOKEN=

# Facturación (ARCA)
SELLER_TAX_CONDITION=responsable_inscripto
SELLER_POINT_OF_SALE=1

# Estadísticas: clave del seudonimizador (≥16 caracteres; por defecto se deriva de VAULT_MASTER_KEY)
# y mínimo de personas distintas para publicar un grupo en el observatorio (k-anonimato)
STATS_PSEUDONYM_SECRET=
STATS_MIN_GROUP_SIZE=10

# Analítica de producto (opcional): PostHog
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Respuestas en audio (opcional): Google Cloud Text-to-Speech
GOOGLE_TTS_API_KEY=

# Notas de voz LOCALES (sin servicios externos ni costo por uso): whisper.cpp en Docker.
#   docker compose --profile ia-local up -d whisper   (la primera vez baja el modelo, ~470 MB)
# SPEECH_TO_TEXT_PROVIDER=local
# WHISPER_MODEL=small   (base: más rápido, peor; medium: mejor, más lento)
# WHISPER_THREADS=4
# Notas de voz (opcional): audio a texto con la API de OpenAI o una compatible (Groq, servidor propio).
# Sin clave, a quien manda un audio se le pide el texto. Los audios se bajan de WhatsApp/Telegram con sus tokens.
SPEECH_TO_TEXT_API_KEY=
# SPEECH_TO_TEXT_BASE_URL=https://api.groq.com/openai/v1
# SPEECH_TO_TEXT_MODEL=whisper-large-v3
SPEECH_TO_TEXT_BASE_URL=
SPEECH_TO_TEXT_MODEL=whisper-1

# Videos: cuadros con ffmpeg (viene en la imagen) para reconocer un video aunque lo hayan recomprimido.
# Cuántos cuadros por video (0 = apagado).
VIDEO_FRAMES=8

# Capturas de pantalla (opcional): tesseract (LOCAL: viene en la imagen, sin servicios externos ni costo),
# claude (usa ANTHROPIC_API_KEY; entiende la captura y descarta la interfaz)
# o google (Cloud Vision: OCR más barato). Sin elegir, se usa el que tenga clave.
OCR_PROVIDER=
OCR_MODEL=claude-haiku-4-5
GOOGLE_VISION_API_KEY=

# Archivo de evidencias (/guardar): dónde se guardan las copias (sin nada: en la base)...
EVIDENCE_DIR=
EVIDENCE_S3_BUCKET=
EVIDENCE_S3_REGION=
EVIDENCE_S3_ENDPOINT=
EVIDENCE_S3_ACCESS_KEY_ID=
EVIDENCE_S3_SECRET_ACCESS_KEY=
EVIDENCE_S3_PREFIX=
# ...sello de tiempo RFC 3161 de un tercero (p. ej. https://freetsa.org/tsr; para uso legal, un certificador licenciado)...
EVIDENCE_TSA_URL=
# ...y copia pública en la Wayback Machine (1 = sí; claves opcionales "clave:secreto" de archive.org)
EVIDENCE_WAYBACK=0
EVIDENCE_WAYBACK_AUTH=

# Freno contra el abuso: captcha en el alta web (Cloudflare Turnstile o hCaptcha). En producción, obligatorio.
CAPTCHA_PROVIDER=turnstile
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET=
# Proxies delante del servidor (IPs o rangos IPv4, separados por coma): sólo a ellos se les cree X-Forwarded-For
TRUSTED_PROXIES=
# Lista ampliada de dominios de mail descartables (uno por línea)
DISPOSABLE_EMAIL_DOMAINS_FILE=

# Redes: un link a una red se lee (oEmbed y metadatos públicos: sin claves).
# Opcionales: API oficial de YouTube (descripción y vistas) y token de una app de Meta (Instagram y Facebook).
YOUTUBE_API_KEY=
META_OEMBED_TOKEN=

# Idiomas (opcional): respuestas en portugués o inglés (/idioma) y comparar fuentes en otros idiomas.
# TRANSLATOR=deepl | google | claude (usa ANTHROPIC_API_KEY). Sin traductor: sólo castellano.
TRANSLATOR=
DEEPL_API_KEY=
GOOGLE_TRANSLATE_API_KEY=
TRANSLATOR_MODEL=claude-haiku-4-5

# Mesa de ayuda externa (opcional): se copian los tickets a Zendesk
ZENDESK_SUBDOMAIN=
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=

# Ambiente: development | test | staging | production (define protecciones y chequeos al arrancar)
APP_ENV=development
# Fuera de producción sólo se envían mensajes a esta lista (números y mails del equipo, separados por coma)
SANDBOX_RECIPIENTS=
# Host de la base de producción: si otro ambiente apunta ahí, no arranca
PRODUCTION_DATABASE_HOST=

# Copias de seguridad: frase de cifrado (guardala FUERA del servidor: sin ella no se pueden leer)
BACKUP_PASSPHRASE=
# Destino: una carpeta...
BACKUP_DIR=
# ...o S3 / Cloudflare R2 / MinIO (recomendado: otra cuenta u otro proveedor)
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_PREFIX=
# Clave para anonimizar la copia de staging (determinística)
STAGING_SCRUB_SECRET=
