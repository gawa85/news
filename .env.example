# Base de datos: PostgreSQL (producción) o SQLite (local). Sin ninguna, usa memoria.
DATABASE_URL=postgres://usuario:clave@localhost:5432/sinhumo
# SQLITE_PATH=./sinhumo.db

# Clave para cifrar contraseñas IMAP, secretos de webhooks, etc. (obligatoria)
VAULT_MASTER_KEY=cambiar-por-una-clave-larga-y-aleatoria
PUBLIC_BASE_URL=https://sinhumo.example
PORT=8080

# IA (opcional: sin clave usa el motor de reglas)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# WhatsApp Business Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_SECRET_TOKEN=

# Mail saliente (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Sin Humo <analizar@sinhumo.example>

# Mail entrante (SMTP): registro MX del dominio apuntando a este servidor
SMTP_INBOUND_PORT=
SMTP_ACCEPTED_DOMAINS=sinhumo.example
# Servidores cuyo Authentication-Results es confiable (tu MTA de recepción)
MAIL_TRUSTED_AUTHSERV_IDS=mx.sinhumo.example

# Pagos
PAYMENTS_WEBHOOK_SECRET=

# MCP por stdio
SINHUMO_API_KEY=

LOAD_DEMO_DATA=0

# Login con Google (opcional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Métricas (Prometheus): token para GET /metrics
METRICS_TOKEN=

# Facturación (ARCA)
SELLER_TAX_CONDITION=responsable_inscripto
SELLER_POINT_OF_SALE=1

# Estadísticas: clave del seudonimizador (≥16 caracteres; por defecto se deriva de VAULT_MASTER_KEY)
# y mínimo de personas distintas para publicar un grupo en el observatorio (k-anonimato)
STATS_PSEUDONYM_SECRET=
STATS_MIN_GROUP_SIZE=10

# Analítica de producto (opcional): PostHog
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Respuestas en audio (opcional): Google Cloud Text-to-Speech
GOOGLE_TTS_API_KEY=

# Notas de voz (opcional): audio a texto con la API de OpenAI o una compatible (Groq, servidor propio).
# Sin clave, a quien manda un audio se le pide el texto. Los audios se bajan de WhatsApp/Telegram con sus tokens.
SPEECH_TO_TEXT_API_KEY=
# SPEECH_TO_TEXT_BASE_URL=https://api.groq.com/openai/v1
# SPEECH_TO_TEXT_MODEL=whisper-large-v3
SPEECH_TO_TEXT_BASE_URL=
SPEECH_TO_TEXT_MODEL=whisper-1

# Mesa de ayuda externa (opcional): se copian los tickets a Zendesk
ZENDESK_SUBDOMAIN=
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=

# Ambiente: development | test | staging | production (define protecciones y chequeos al arrancar)
APP_ENV=development
# Fuera de producción sólo se envían mensajes a esta lista (números y mails del equipo, separados por coma)
SANDBOX_RECIPIENTS=
# Host de la base de producción: si otro ambiente apunta ahí, no arranca
PRODUCTION_DATABASE_HOST=

# Copias de seguridad: frase de cifrado (guardala FUERA del servidor: sin ella no se pueden leer)
BACKUP_PASSPHRASE=
# Destino: una carpeta...
BACKUP_DIR=
# ...o S3 / Cloudflare R2 / MinIO (recomendado: otra cuenta u otro proveedor)
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_PREFIX=
# Clave para anonimizar la copia de staging (determinística)
STAGING_SCRUB_SECRET=
